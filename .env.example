# Animawave environment template
# Copy to `.env` before editing:  cp .env.example .env
# All variables are optional. The desktop app itself reads settings from
# GSettings; these env vars are honored by the build pipeline and by dev builds.

# === Build / tooling ===
# Standard Rust env vars — see https://doc.rust-lang.org/cargo/reference/environment-variables.html
# RUST_LOG=debug              # pretty_env_logger + log crate target
# RUST_BACKTRACE=1            # show backtraces on panic
# RUSTFLAGS="-C target-cpu=native"  # local release tuning

# === Flatpak dev builds ===
# FLATPAK_DEST=repo           # output repo for `flatpak-builder --install --user`
# GSETTINGS_SCHEMA_DIR=build/data  # use locally-built gschemas instead of system ones

# === GTK / GNOME ===
# GTK_DEBUG=interactive        # launch the GTK Inspector on startup
# GDK_DEBUG=gl                # force a specific GL backend

# === Audio ===
# GST_DEBUG=3                 # GStreamer log level (0=none, 9=verbose)
# GST_DEBUG_FILE=/path.log    # send GST logs to file instead of stderr

# === i18n ===
# GETTEXT_DIR=/usr/share/local # override gettext locale search path
